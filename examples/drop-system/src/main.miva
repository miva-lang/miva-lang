module main;

File = struct {
  id: int,
}

file_close = (ref self: File) => {
  printlns!("close file");
  printlns!(self.id);
}

impl File {
  op_drop file_close,
}

consume = (f: File) => {
  printlns!("consumed");
}

make_file = (id: int): File => {
  let f File = struct File { id = id };
  return move f;
}

async task = (id: int): future[int] => {
  let t File = struct File { id = id };
  printlns!("task body");
  return id * 10;
}

early = () => {
  let e File = struct File { id = 6 };
  printlns!("before early drop");
  drop(e);
  printlns!("after early drop");
}

branchy = (flag: bool) => {
  let f File = struct File { id = 7 };
  if (flag) {
    drop(f);
  } else {
    consume(move f);
  };
  printlns!("branch done");
}

Handle = struct {
  f: File,
}

handle_close = (ref self: Handle) => {
  printlns!("close handle");
}

impl Handle {
  op_drop handle_close,
}

Wrapper = struct {
  h: Handle,
}

nested = () => {
  let h Handle = struct Handle { f = struct File { id = 8 } };
  printlns!("nested end");
}

wrapped = () => {
  let w Wrapper = struct Wrapper { h = struct Handle { f = struct File { id = 9 } } };
  printlns!("wrapped end");
}

main = () => {
  printlns!("start");
  let a File = struct File { id = 1 };
  let b File = struct File { id = 2 };
  if (true) {
    let inner File = struct File { id = 3 };
    printlns!("inner end");
  };
  let d File = make_file(4);
  consume(move d);
  let r int = await(task(5));
  printlns!(r);
  early();
  branchy(true);
  nested();
  wrapped();
  printlns!("end");
}
