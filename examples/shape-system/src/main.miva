module main;

// Define a shape that requires name and age fields
PersonShape = shape {
  name: string,
  age: int,
}

// Define a shape with a single field
HasId = shape {
  id: int,
}

// Structs that satisfy shapes (exact match)
Employee = struct {
  name: string,
  age: int,
}

// Structs that satisfy shapes (superset — extra fields OK)
Customer = struct {
  name: string,
  age: int,
  email: string,
}

// Generic shape with type parameter
HasValue[T] = shape {
  value: T,
}

// Struct satisfying HasValue[int]
IntBox = struct {
  value: int,
}

StringBox = struct {
  value: string,
}

main = () => {
  // Employee satisfies PersonShape (exact match)
  let emp Employee = struct Employee { name = "Alice", age = 30 };
  printlns!("Employee name:", emp.name);
  printlns!("Employee age:", emp.age);

  // Customer satisfies PersonShape (superset — extra fields OK)
  let cust Customer = struct Customer { name = "Bob", age = 25, email = "bob@example.com" };
  printlns!("Customer name:", cust.name);
  printlns!("Customer age:", cust.age);
  printlns!("Customer email:", cust.email);

  // IntBox satisfies HasValue[int]
  let box1 IntBox = struct IntBox { value = 42 };
  printlns!("Box value:", box1.value);

  // StringBox satisfies HasValue[string]
  let box2 StringBox = struct StringBox { value = "hello" };
  printlns!("Box string:", box2.value);
}
