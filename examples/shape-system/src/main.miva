module main;

PersonShape = shape {
  name: string,
  age: int,
}

Employee = struct {
  name: string,
  age: int,
}

Customer = struct {
  name: string,
  age: int,
  email: string,
}

HasValue[T] = shape {
  value: T,
}

IntBox = struct {
  value: int,
}

StringBox = struct {
  value: string,
}

main = () => {
  let emp Employee = struct Employee { name = "Alice", age = 30 };
  printlns!(emp.name);
  printlns!(emp.age);

  let cust Customer = struct Customer { name = "Bob", age = 25, email = "bob@example.com" };
  printlns!(cust.name);
  printlns!(cust.email);

  let box1 IntBox = struct IntBox { value = 42 };
  printlns!(box1.value);

  let box2 StringBox = struct StringBox { value = "hello" };
  printlns!(box2.value);
}
