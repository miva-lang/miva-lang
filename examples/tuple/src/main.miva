module main;

pair = (x: int, y: int): (int, int) => {
    return (x, y);
}

mixed = (): (int, bool, string) => {
    return (1, true, "hello");
}

nested = (): (int, (bool, string)) => {
    return (1, (true, "nested"));
}

sum_pair = (p: (int, int)): int => {
    return p.0 + p.1;
}

compare = (a: (int, bool), b: (int, bool)): bool => {
    return a == b;
}

main = () => {
    let p = pair(10, 20);
    printlns!("pair.0 =", p.0);
    printlns!("pair.1 =", p.1);

    let m = mixed();
    printlns!("mixed.0 =", m.0);
    printlns!("mixed.1 =", m.1);
    printlns!("mixed.2 =", m.2);

    let n = nested();
    printlns!("nested.0 =", n.0);
    printlns!("nested.1.0 =", n.1.0);
    printlns!("nested.1.1 =", n.1.1);

    let result = sum_pair((5, 3));
    printlns!("sum =", result);

    let c = compare((1, true), (1, true));
    printlns!("compare =", c);

    let ne = compare((1, true), (2, false));
    printlns!("not equal =", ne);
}
