module std.mutex;

// ── Mutual exclusion lock ──────────────────────────────────────────────────────
//
// `Mutex` provides mutual exclusion for shared data accessed by multiple async
// tasks. The underlying C++ object is a heap-allocated `std::mutex` referenced
// by an opaque `ptrany` handle.
//
// Ownership: each `Mutex` owns exactly one C++ mutex. Call `free` exactly once
// to release it. Passing a null handle or an already-freed mutex to any
// function triggers a runtime panic.
//
// Safety: all mutex operations are `unsafe` because they dereference a raw
// C++ pointer. The caller is responsible for:
//   - calling `free` exactly once on a live `Mutex`;
//   - pairing every `lock` with a matching `unlock`;
//   - not locking from an `async` function that yields while holding the lock.
//
// Note: `std::mutex` is NOT reentrant — locking the same mutex twice from the
// same thread causes a deadlock.

Mutex = struct {
    handle: ptrany,
}

// Create a new unlocked `Mutex`.
unsafe create = (): Mutex => struct Mutex { handle = mutex_new() }

// Acquire the lock, blocking until it becomes available.
unsafe lock = (ref m: Mutex) => {
  mutex_lock(m.handle);
}

// Release the lock.
unsafe unlock = (ref m: Mutex) => {
  mutex_unlock(m.handle);
}

// Destroy the mutex and free the underlying C++ resource.
unsafe free = (ref m: Mutex) => {
  mutex_free(m.handle);
}

export Mutex;
export create;
export lock;
export unlock;
export free;
