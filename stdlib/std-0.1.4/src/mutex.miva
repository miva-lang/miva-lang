module std.mutex;

// ── Mutual exclusion lock ──────────────────────────────────────────────────────
//
// `Mutex` provides mutual exclusion for shared data accessed by multiple async
// tasks. The underlying C++ object is a heap-allocated `std::mutex` referenced
// by an opaque `ptrany` handle.
//
// Ownership: each `Mutex` owns exactly one C++ mutex. Call `free` exactly once
// to release it. Passing a null handle or an already-freed mutex to any
// function triggers a runtime panic.
//
// Safety: all mutex operations are `unsafe` because they dereference a raw
// C++ pointer. The caller is responsible for:
//   - calling `free` exactly once on a live `Mutex`;
//   - pairing every `lock` with a matching `unlock`;
//   - not locking from an `async` function that yields while holding the lock.
//
// Note: `std::mutex` is NOT reentrant — locking the same mutex twice from the
// same thread causes a deadlock.
//
// ── MutexGuard (RAII lock self-unlocking) ─────────────────────────────────────
//
// `MutexGuard` is a RAII wrapper around a locked mutex. It acquires the lock
// via `guard(m)` and releases it automatically when dropped (end of scope or
// explicit `drop(g)`). This eliminates the risk of forgetting to unlock and
// handles all exit paths (returns, breaks, continues) without manual effort.
//
// `MutexGuard` is move-only because it contains a `ptrany` field. Copying a
// guard would cause double-unlock on drop — the compiler prevents this via
// the move-check (E0001).

Mutex = struct {
    handle: ptrany,
}

MutexGuard = struct {
    handle: ptrany,
}

// Create a new unlocked `Mutex`.
unsafe create = (): Mutex => struct Mutex { handle = mutex_new() }

// Acquire the lock, blocking until it becomes available.
unsafe lock = (ref m: Mutex) => {
  mutex_lock(m.handle);
}

// Release the lock.
unsafe unlock = (ref m: Mutex) => {
  mutex_unlock(m.handle);
}

// Destroy the mutex and free the underlying C++ resource.
unsafe free = (ref m: Mutex) => {
  mutex_free(m.handle);
}

// Create a `MutexGuard` that locks `m` and auto-unlocks on drop.
// `m` is borrowed (not consumed), so the same mutex can be guarded multiple times.
unsafe guard = (ref m: Mutex): MutexGuard => {
  mutex_lock(m.handle);
  let g MutexGuard = struct MutexGuard { handle = m.handle };
  return g;
}

// Drop function for `MutexGuard`: unlocks the underlying mutex.
unsafe drop_guard = (ref self: MutexGuard) => {
  mutex_unlock(self.handle);
}

impl MutexGuard {
  op_drop drop_guard,
}

export Mutex;
export MutexGuard;
export create;
export lock;
export unlock;
export free;
export guard;
